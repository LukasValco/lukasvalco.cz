---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import JsonLd from '~/components/common/JsonLd.astro';

import { getPermalink } from '~/utils/permalinks';
import { personSchema, professionalServiceSchema, websiteSchema } from '~/utils/schema';

const metadata = {
  title: 'Lukáš Valčo — Fotovoltaický expert a energetický poradce',
  description:
    'Senior specialista technické podpory FV systémů a certifikovaný Fotovoltaický expert ČFA. Pomáhám lidem rozumět fotovoltaice a energetice — srozumitelně a z praxe.',
  ignoreTitleTemplate: true,
};

const oblasti = [
  {
    title: 'Fotovoltaika a technická podpora',
    description:
      'Rozumím FV systémům od A do Z — návrh, provoz, diagnostika i řešení eskalovaných případů. Denně pomáhám kolegům, obchodním zástupcům i instalačním partnerům.',
    icon: 'tabler:solar-panel-2',
  },
  {
    title: 'Energetické poradenství',
    description:
      'Certifikovaný energetický poradce. Pomáhám se rozhodováním kolem fotovoltaiky, akumulace, výkupu a spotřeby energie.',
    icon: 'tabler:bulb',
  },
  {
    title: 'Termovizní diagnostika dronem',
    description:
      'Termovizní kontrola FV panelů dronem DJI Mavic 3T — detekce defektů a teplotních anomálií na střechách.',
    icon: 'tabler:drone',
  },
  {
    title: 'AI jako akcelerátor',
    description:
      'AI beru jako násobič znalostí, ne jako náhradu. Aktivně se vzdělávám v AI inženýrství a stavím vlastní nástroje pro fotovoltaiku a energetiku.',
    icon: 'tabler:robot',
  },
];
---

<Layout metadata={metadata}>
  <JsonLd schema={[personSchema, websiteSchema, professionalServiceSchema]} />
  <!-- Hero — dvousloupcový editorial ******************* -->

  <section class="not-prose relative overflow-hidden md:-mt-[76px]">
    <!-- teplé „slunce" vlevo → modrá vpravo -->
    <div class="hero-aura pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
      <div class="py-12 md:py-20">
        <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-16">
          <!-- Text -->
          <div
            class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 text-center md:text-left"
          >
            <p class="text-secondary font-heading mb-5 text-sm font-bold tracking-widest uppercase">
              FV expert · Energetický poradce · České Budějovice
            </p>
            <h1
              class="text-heading font-heading mb-6 text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl"
            >
              Pomáhám lidem rozumět <span class="text-accent">fotovoltaice</span> a
              <span class="text-accent">energetice</span>
            </h1>
            <p class="text-muted mb-8 text-lg leading-relaxed">
              Senior specialista technické podpory FV systémů a certifikovaný Fotovoltaický expert ČFA. Srozumitelně
              propojuji technologie, data a praxi — a znalosti sdílím, ne schovávám.
            </p>
            <div class="flex flex-col gap-4 sm:flex-row sm:justify-center md:justify-start">
              <Button variant="primary" text="Domluvit konzultaci" href={getPermalink('/kontakt')} icon="tabler:mail" />
              <Button text="Moje služby" href={getPermalink('/sluzby')} />
            </div>
          </div>

          <!-- Portrét -->
          <div
            class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 relative mx-auto w-full max-w-xs sm:max-w-sm"
          >
            <div class="ring-line relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl ring-1">
              <Image
                src="~/assets/images/portrait/avatar-hero.png"
                alt="Kreslený portrét Lukáše Valča (bude nahrazeno vlastní profesionální fotkou)"
                loading="eager"
                fetchpriority="high"
                width={720}
                height={900}
                widths={[360, 540, 720]}
                sizes="(max-width: 768px) 90vw, 42vw"
                format="webp"
                class="absolute inset-0 h-full w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Note Widget ******************* -->

  <Note
    icon="tabler:quote"
    description="„Mám pocit, že jsem se pro technickou podporu narodil – naplňuje mě, když mohu být užitečný.“"
  />

  <!-- Oblasti — kartový grid *************** -->

  <section id="oblasti" class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="mb-10 text-center">
      <p class="text-secondary mb-2 text-sm font-bold tracking-wider uppercase">Čemu se věnuji</p>
      <h2 class="text-heading font-heading text-3xl font-bold tracking-tight md:text-4xl">
        Oblasti, ve kterých pomáhám
      </h2>
      <p class="text-muted mx-auto mt-3 max-w-2xl text-base">
        Od technické podpory fotovoltaiky přes energetické poradenství až po moderní nástroje, které posouvají kvalitu
        mé práce.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        oblasti.map((o) => (
          <article class="border-line bg-surface group flex flex-col rounded-2xl border p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="bg-primary/10 dark:bg-primary/20 mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl">
              <Icon name={o.icon} class="text-primary h-6 w-6" />
            </div>
            <h3 class="text-heading mb-2 text-lg font-bold tracking-tight">{o.title}</h3>
            <p class="text-muted grow text-sm">{o.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Co mě žene"
    title="Životní cesta, ne kariérní žebříček"
    image={{
      src: '~/assets/images/work/placeholder-fv-panely.png',
      alt: 'Kreslený návrh: Lukáš u fotovoltaické elektrárny (bude nahrazeno vlastní fotkou)',
      width: 800,
      height: 600,
    }}
    items={[
      {
        title: 'Radost z pomoci',
        description:
          'Nejspokojenější jsem ve chvíli, kdy konkrétnímu člověku pomohu vyřešit jeho konkrétní problém. Tuhle radost si nesu celou kariérou.',
      },
      {
        title: 'Proaktivita',
        description:
          'Nesedím a nečekám. Když vidím problém nebo příležitost, jdu jí naproti — sám si doplním vzdělání a hledám lepší cesty.',
      },
      {
        title: 'Sdílení znalostí',
        description:
          'Jdu opačnou cestou než většina: znalosti sdílím, neschovávám. Věřím, že tím si buduji autoritu a důvěru.',
      },
    ]}
    callToAction={{
      text: 'Více o mně',
      href: getPermalink('/o-mne'),
      icon: 'tabler:chevron-right',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-heading mb-2 text-2xl font-bold tracking-tight sm:text-3xl">Kdo jsem</h3>
      <p>
        Pracuji jako senior specialista technické podpory FV systémů ve společnosti E.ON Energie, a.s., vedu malý tým a
        řeším eskalované případy. A protože věřím tomu, co říkám — fotovoltaika jede i na střeše mého domu v jihočeském
        Dražíči, do práce jezdím elektromobilem.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-subtle dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features2 Widget ************** -->

  <Features2
    title="S čím vám mohu pomoci"
    subtitle="Konkrétní oblasti, ve kterých nabízím poradenství a podporu."
    tagline="Služby"
    columns={2}
    items={[
      {
        title: 'Konzultace k fotovoltaice',
        description:
          'Probereme váš FV systém, provoz, monitoring i řešení problémů. Telefon před e-mailem — řešíme přímo.',
        icon: 'tabler:messages',
      },
      {
        title: 'Simulace v PV*SOL',
        description:
          'Návrh a simulace FV systémů v profesionálním softwaru PV*SOL (certifikát Advanced) — výnosy, zastínění, zátěžové profily.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Energetické poradenství',
        description: 'Pomoc s rozhodováním kolem akumulace, výkupu a spotřeby energie pro domácnosti.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Termovizní kontrola dronem',
        description: 'Diagnostika FV panelů termokamerou — detekce defektů a teplotních anomálií.',
        icon: 'tabler:drone',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-subtle dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Projekty Widget *************** -->

  <section id="projekty" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-10 text-center">
      <p class="text-secondary mb-2 text-sm font-bold tracking-wider uppercase">Co stavím</p>
      <h2 class="text-heading font-heading text-3xl font-bold tracking-tight md:text-4xl">
        Projekty, na kterých pracuji
      </h2>
      <p class="text-muted mx-auto mt-3 max-w-2xl text-base">
        Vedle poradenství stavím nástroje a weby, které mají lidem usnadnit orientaci ve fotovoltaice a energetice. Oba
        projekty právě vznikají.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <a
        href="https://slunora.cz"
        target="_blank"
        rel="noopener"
        class="group border-line bg-surface relative flex flex-col rounded-2xl border p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        <span
          class="absolute right-6 top-6 inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-950/40 dark:text-amber-200"
        >
          <Icon name="tabler:tool" class="h-3.5 w-3.5" />
          Ve výstavbě
        </span>
        <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-primary/20">
          <Icon name="tabler:solar-panel-2" class="text-primary h-6 w-6" />
        </div>
        <h3 class="text-heading mb-2 text-xl font-bold tracking-tight">slunora.cz</h3>
        <p class="text-muted mb-4 grow text-sm">
          Online nástroje z oblasti fotovoltaiky — kalkulačky a pomůcky, které pomohou s rozhodováním a výpočty.
        </p>
        <span class="text-primary inline-flex items-center gap-1.5 text-sm font-medium">
          Navštívit web
          <Icon name="tabler:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
        </span>
      </a>

      <a
        href="https://renora.cz"
        target="_blank"
        rel="noopener"
        class="group border-line bg-surface relative flex flex-col rounded-2xl border p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        <span
          class="absolute right-6 top-6 inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-950/40 dark:text-amber-200"
        >
          <Icon name="tabler:tool" class="h-3.5 w-3.5" />
          Ve výstavbě
        </span>
        <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-primary/20">
          <Icon name="tabler:book-2" class="text-primary h-6 w-6" />
        </div>
        <h3 class="text-heading mb-2 text-xl font-bold tracking-tight">renora.cz</h3>
        <p class="text-muted mb-4 grow text-sm">
          Edukativní a informační web z oblasti energetického poradenství — renovační pas, program Nová zelená úsporám.
          Aby se v tom lidé vyznali.
        </p>
        <span class="text-primary inline-flex items-center gap-1.5 text-sm font-medium">
          Navštívit web
          <Icon name="tabler:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
        </span>
      </a>
    </div>
  </section>

  <!-- BlogLatestPosts Widget ******** -->

  <BlogLatestPosts
    title="Z blogu"
    information={`Sdílím poznatky z praxe — fotovoltaika, energetika, drony i osobní rozvoj a práce s AI. Obsah poroste postupně.`}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Napište mi',
        href: getPermalink('/kontakt'),
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Máte otázku k fotovoltaice nebo energetice?</Fragment>

    <Fragment slot="subtitle">
      Hledáte poradenství, chcete si popovídat o solárních systémech, nebo vás zajímá, co se děje v energetice? Ozvěte
      se.
    </Fragment>
  </CallToAction>
</Layout>
