---
import Layout from '~/layouts/PageLayout.astro';

import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Kontakt',
  description:
    'Ozvěte se Lukášovi Valčovi — poradenství k fotovoltaice, solárním systémům a energetice. E-mail, LinkedIn, České Budějovice / Dražíč, Jihočeský kraj.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Kontakt"
    title="Spojme se"
    subtitle="Hledáte poradenství k fotovoltaice, chcete probrat solární systém, nebo vás zajímá energetika? Napište mi — ozvu se."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    columns={2}
    items={[
      {
        title: 'E-mail',
        description:
          '<a href="mailto:Lukas.Valco@outlook.com" class="text-primary hover:underline">Lukas.Valco@outlook.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'LinkedIn',
        description:
          '<a href="https://linkedin.com/in/lukasvalco" target="_blank" rel="noopener" class="text-primary hover:underline">linkedin.com/in/lukasvalco</a>',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'Kde mě najdete',
        description: 'České Budějovice / Dražíč, Jihočeský kraj',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Jak pracuji',
        description: 'Telefon a přímou domluvu mám raději než e-mail — věci se tak řeší rychleji.',
        icon: 'tabler:messages',
      },
    ]}
  />
</Layout>
