---
import Layout from '~/layouts/PageLayout.astro';

import HeroText from '~/components/widgets/HeroText.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Kariéra',
  description:
    'Kariérní cesta Lukáše Valča od IT servisu a terénní podpory k technické podpoře solárních systémů v E.ON. Proaktivita a investice do sebe jako červená nit.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Kariéra"
    title="Cesta od terénní podpory k solární energetice"
    subtitle="Přechody jsem neplánoval lineárně — reagoval jsem na příležitosti a vnitřní signály. Červenou nití zůstává radost z pomoci druhým a proaktivní přístup."
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Pracovní zkušenosti a vzdělávání"
    items={[
      {
        title: 'Dnes',
        icon: 'tabler:check',
      },
      {
        title:
          'Senior specialista technické podpory — solární systémy <br /> <span class="font-normal">E.ON Energie, a.s., České Budějovice</span> <br /> <span class="text-sm font-normal">2021 – dosud</span>',
        description:
          'FV technická podpora, školení, znalostní báze. Vedení malého týmu, řešení eskalovaných případů, tvorba e-learningu a zkušenosti s termovizní kontrolou FV panelů dronem. Podílím se i na revizi odborných článků o fotovoltaice v poradně E.ON.',
        icon: 'tabler:solar-panel',
      },
      {
        title:
          'Výuční list — elektrikář <br /> <span class="font-normal">Roční rekvalifikační kurz při zaměstnání</span> <br /> <span class="text-sm font-normal">2023 – 2024</span>',
        description:
          'Profesní kvalifikace montér slaboproudých zařízení, elektrických rozvaděčů, elektrických sítí a hromosvodů. Doplnil jsem si ji z vlastní iniciativy vedle práce.',
        icon: 'tabler:school',
      },
      {
        title:
          'Technical Support Solar Energy <br /> <span class="font-normal">Fronius CZ, Praha</span> <br /> <span class="text-sm font-normal">2020 – 2021</span>',
        description: 'Technická podpora fotovoltaiky — vstup do oboru solární energetiky.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Service Technician <br /> <span class="font-normal">URC Systems, Praha</span> <br /> <span class="text-sm font-normal">2015 – 2019</span>',
        description:
          'Servis speciálních vozidlových systémů pro Policii ČR. Servis robotických systémů Talon pro Armádu ČR — včetně školení a certifikace v Bostonu (QinetiQ).',
        icon: 'tabler:robot',
      },
      {
        title:
          'Quality Control Analyst <br /> <span class="font-normal">Nielsen, Praha</span> <br /> <span class="text-sm font-normal">2014 – 2015</span>',
        description: 'Datová kvalita a analýza napříč mezinárodními regiony.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Technik <br /> <span class="font-normal">Nielsen</span> <br /> <span class="text-sm font-normal">2013 – 2014</span>',
        description: 'Terénní instalace peoplemetrů — komunikace s klienty napříč sociálními vrstvami.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Vedoucí obchodní divize <br /> <span class="font-normal">SEGURO s.r.o.</span> <br /> <span class="text-sm font-normal">2009 – 2013</span>',
        description: 'Kamerové systémy, zabezpečení, e-shop.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Technik výpočetní techniky <br /> <span class="font-normal">Česká pošta</span> <br /> <span class="text-sm font-normal">2007 – 2009</span>',
        description: 'IT servis a podpora.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Technik Postservisu <br /> <span class="font-normal">Česká pošta</span> <br /> <span class="text-sm font-normal">2006 – 2007</span>',
        description: 'Servis kompletačních linek Kern.',
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Kariérní vzorec"
    title="Investice do sebe → příležitosti přicházejí samy"
    callToAction={{
      text: 'Jak to probíhalo krok za krokem',
      href: getPermalink('/blog/proaktivita-a-zmena-oboru'),
      icon: 'tabler:chevron-right',
    }}
    image={{
      src: '~/assets/images/portrait/avatar-omne-cesta.png',
      alt: 'Kreslený návrh: Lukáš u návrhu FV systému (bude nahrazeno vlastní fotkou)',
      width: 800,
      height: 600,
    }}
    items={[
      {
        title: 'Změna oboru (2019/2020)',
        description:
          'Vědomé, proaktivní rozhodnutí — identifikoval jsem perspektivní obor, sám si doplnil vzdělání (e-learning) a upravil profil na LinkedIn.',
      },
      {
        title: 'Nabídky přišly samy',
        description: 'Výsledkem byly dvě po sobě jdoucí nabídky bez aktivního hledání — Fronius, poté E.ON.',
      },
      {
        title: 'Proaktivita jako červená nit',
        description:
          'Stejný vzorec se opakuje: certifikace v Bostonu, samostatné prohlubování znalostí termovize dronem — vždy z vlastní iniciativy.',
      },
    ]}
  >
    <Fragment slot="content">
      <p>Nepřecházel jsem mezi rolemi náhodně. Pokaždé šlo o reakci na příležitost a investici do vlastního profilu.</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-subtle dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Certifikáty a vzdělání',
        href: getPermalink('/certifikaty'),
        icon: 'tabler:certificate',
      },
      { text: 'Kontakt', href: getPermalink('/kontakt') },
    ]}
    title="Zajímá vás víc?"
    subtitle="Podívejte se na mé certifikáty a vzdělání, nebo se rovnou ozvěte."
  />
</Layout>
